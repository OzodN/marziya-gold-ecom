# ==============================================================================
# MARZIYA GOLD E-COMMERCE — PRODUCTION ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================
# Copy or set these environment variables in your deployment platform (Railway PaaS).
# NEVER commit raw production credentials, passwords, or secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE (Spring Boot 4.x / Java 21)
# ------------------------------------------------------------------------------

# Application Port (Railway automatically sets PORT, defaults to 8080)
PORT=8080

# Database Connectivity (PostgreSQL)
# Note: Railway Managed PostgreSQL provides ${{Postgres.DATABASE_URL}} or individual vars.
# Spring Boot requires JDBC format: jdbc:postgresql://<host>:<port>/<dbname>
SPRING_DATASOURCE_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}?sslmode=require
SPRING_DATASOURCE_USERNAME=${{Postgres.PGUSER}}
SPRING_DATASOURCE_PASSWORD=${{Postgres.PGPASSWORD}}

# Backwards compatibility / Direct Spring properties
JDBC_DATABASE_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}?sslmode=require
DB_USERNAME=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}

# JWT Security Configuration
# Must be a cryptographically secure random string of at least 32 characters (HMAC-SHA256)
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_string_minimum_32_bytes!
JWT_EXPIRATION_MS=86400000

# Initial Admin / Master Credentials (for first-time seed / bootstrap)
ADMIN_DEFAULT_PASSWORD=replace_with_strong_admin_initial_master_password

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins (e.g. production domain and railway frontend domain)
CORS_ALLOWED_ORIGINS=https://marziyagold.uz,https://www.marziyagold.uz,https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}

# Cloudflare R2 Media Storage (S3-compatible, Zero-Egress costs)
R2_ENDPOINT=https://<cloudflare_account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET=marziya-gold-media

# Cloudinary Alternative Media Storage (if using Cloudinary asset pipeline)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=marziya-gold

# ------------------------------------------------------------------------------
# 2. FRONTEND SERVICE (Next.js 15 / Node.js 22)
# ------------------------------------------------------------------------------

# Environment & Server Config
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Public APIs exposed to browser client (embedded at build/runtime)
# Points to public URL of the backend service (or custom API domain)
NEXT_PUBLIC_API_URL=https://api.marziyagold.uz
# Alternative if using direct Railway generated domain:
# NEXT_PUBLIC_API_URL=https://${{backend.RAILWAY_PUBLIC_DOMAIN}}

# Public Media CDN URL (Cloudflare R2 custom domain or Cloudinary CDN)
NEXT_PUBLIC_MEDIA_URL=https://media.marziyagold.uz

# Private Network Backend Address (Used by Next.js server-side rewrites & SSR fetch)
# Leverages Railway private DNS resolution ($0 bandwidth between services in same project)
INTERNAL_API_URL=http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:8080
BACKEND_URL=http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:8080
